# Copie ce fichier en ".env" (ou exporte ces variables dans ton
# environnement) puis adapte les valeurs à ton installation locale.
# NOTE : le code actuel lit uniquement DATABASE_URL via os.environ ;
# les autres variables ci-dessous sont indicatives pour documenter
# les services externes utilisés par le backend (Ollama).

# --- PostgreSQL (données structurées : formations, projets...) ---
DATABASE_URL=postgresql://<username>:<password>@localhost:5432/<database>

# --- Ollama (LLM + embeddings, voir rag/config.py) ---
# Utilisé tel quel dans le code (non lu depuis l'environnement) :
#   URL_OLLAMA  = http://localhost:11434/api/generate
#   MODELE_LLM  = qwen3:8b
#   MODELE_EMBEDDING = qwen3-embedding:4b
